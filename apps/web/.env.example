# Animora Studio — Environment Variables Template
# Copy this file to `apps/web/.env.local` for local overrides. Never commit `.env.local`.

# --- Core App & Security ---
APP_URL=http://localhost:3000
ENABLE_DEMO_SWITCHER=true
# Generate a 64-char hex key for AES-256-GCM Instagram OAuth token encryption in production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- AI Brainstorming, Scripting & Captions (F-05, F-08) ---
# Optional locally (smart structured fallback works offline); recommended for live Gemini AI
GEMINI_API_KEY=

# --- Dual Voiceover Engine (F-05, F-07) ---
# Microsoft Edge Neural TTS is 100% Free & Built-in (no key required)
# Optional: Add ElevenLabs API key to unlock ElevenLabs Pro (+1 Credit) studio voices
ELEVENLABS_API_KEY=

# --- Per-Member Instagram Connect OAuth 2.0 (F-08, F-09) ---
# Optional locally (Sandbox Mock Mode works out-of-the-box without Meta App credentials)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/v1/integrations/instagram/callback

# --- Transactional Email for OTP & Password Reset (F-03, F-12) ---
# Optional locally (Dev Sandbox displays OTP and reset token inline)
RESEND_API_KEY=

# --- Billing & Credit Top-Ups (F-11) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
